# Database Configuration (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/rahomitra?schema=public"

# Environment & Server
NODE_ENV="development"
PORT="5000"

# CORS Configuration (Comma-separated list of origins, explicit list, no wildcard '*')
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# JWT Secrets & Tokens
JWT_ACCESS_SECRET="replace-with-a-secure-random-secret-key-at-least-32-chars-long"
JWT_ISSUER="rahomitra-api"
JWT_AUDIENCE="rahomitra-app"

# Cookie Configuration
COOKIE_DOMAIN="localhost"

# Mail Settings (SMTP)
MAIL_HOST="smtp.example.com"
MAIL_PORT="587"
MAIL_USER="placeholder-mail-user"
MAIL_PASS="placeholder-mail-pass"
MAIL_FROM="noreply@rahomitra.com"

# Admin Initial Seed Credentials (Used only by seed.ts, never committed to git)
ADMIN_EMAIL="admin@rahomitra.com"
ADMIN_PASSWORD="replace-with-secure-admin-password"
